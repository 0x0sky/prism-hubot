# Template unit. Placeholders are substituted by deploy/install-service.sh.

[Unit]
Description=prism-hubot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=__DEPLOY_USER__
WorkingDirectory=__DEPLOY_PATH__/current
EnvironmentFile=__DEPLOY_PATH__/shared/.env
ExecStart=__BUNDLE_BIN__ exec rackup config.ru -s Puma -o __BIND_ADDRESS__ -p __PORT__
Restart=on-failure
RestartSec=5

NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=full
ReadWritePaths=__DEPLOY_PATH__/shared/var/interaction-state

[Install]
WantedBy=multi-user.target
