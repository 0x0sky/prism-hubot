PRISM_BOT_INSTANCE_ID=prism-hubot
PRISM_BOT_TELEGRAM_TOKEN=replace-with-botfather-token
PRISM_BOT_TELEGRAM_WEBHOOK_SECRET=replace-with-at-least-32-random-characters
# Public HTTPS URL of this deployment's /telegram/webhook endpoint. Used by
# `rake telegram:webhook` to register the webhook; never read at request time.
PRISM_HUBOT_WEBHOOK_URL=https://prism.example.test/telegram/webhook
# Optional execution-context restriction. Human identity is resolved by Prism Hub.
PRISM_BOT_TELEGRAM_ALLOWED_CHAT_IDS=[]
PRISM_BOT_DEFAULT_CHANNEL_IDS=[]
PRISM_BOT_DEFAULT_LOCALE=uk-UA
PRISM_BOT_DEFAULT_VOICE_PROFILE=0x0sky.uk_SP
PRISM_BOT_DISPATCH_POLICY=require_all_valid
PRISM_HUB_BASE_URL=https://hub.example.test
PRISM_HUB_API_TOKEN=replace-with-scoped-prism-client-credential
PRISM_BOT_MAX_WEBHOOK_BYTES=1048576
PRISM_BOT_ALLOW_INSECURE_HTTP=false

# Client-owned conversational state. In production this directory must live on persistent storage.
PRISM_HUBOT_INTERACTION_STATE_DIR=var/interaction-state
PRISM_HUBOT_INTERACTION_STATE_TTL_SECONDS=900
